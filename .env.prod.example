# Production settings. Copy to .env.prod (never commit it) and replace every "change-me" and example value.
# Use: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build --wait
COMPOSE_PROJECT_NAME=gdsite
APP_NAME=My Business
# Three names must resolve to this server: example.com, admin.example.com, api.example.com
APP_DOMAIN=example.com
# echo "base64:$(openssl rand -base64 32)"
APP_KEY=
HTTP_PORT=80
HTTPS_PORT=443
# Directory holding fullchain.pem and privkey.pem (one certificate valid for all three names)
TLS_CERT_DIR=/etc/gdsite/certs

# Pins (source of truth: docs/VERSIONS.md)
PHP_VERSION=8.5.12
COMPOSER_VERSION=2.11.2
NODE_VERSION=24.22.3
NGINX_VERSION=1.30.6
MARIADB_VERSION=11.8.9
# Any string that changes with each release (for example the git tag); the portal rebuilds when it changes
IMAGE_ID=1.0.0

MARIADB_DATABASE=gdsite
MARIADB_USER=gdsite
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me

LOCALE_DEFAULT=en
LOCALE_FALLBACK=en
LOCALE_SUPPORTED=en

UPLOADS_CONTAINER_PATH=/var/www/uploads
UPLOADS_MAX_MB=5

# First admin (created or updated from these values by `php artisan db:seed`)
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me
OAUTH_ADMIN_CLIENT_ID=e98a6a07-2975-4f52-941e-d9b6b27eb580

# Webhook shared by the API and the portal
PORTAL_REVALIDATE_SECRET=change-me

# Mail (contact form notifications). MAIL_MAILER=log writes them to the log instead of sending.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
CONTACT_NOTIFY_TO=

LOG_LEVEL=warning
# Browser apps on other origins that may call the API (empty = closed)
CORS_ALLOWED_ORIGINS=
# Only the sources whose X-Forwarded-For nginx believes (see docs/SECURITY.md)
TRUSTED_PROXY_CIDR=172.16.0.0/12
