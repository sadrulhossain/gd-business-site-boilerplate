# Copy to .env (make up does this automatically) and change every "change-me".
COMPOSE_PROJECT_NAME=gdsite
COMPOSE_PROFILES=dev
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_DOMAIN=gdsite.localhost

# Pins (source of truth: docs/VERSIONS.md; checked by `make versions`)
PHP_VERSION=8.5.12
LARAVEL_VERSION=13.29.0
COMPOSER_VERSION=2.11.2
PHPREDIS_VERSION=6.3.0
NODE_VERSION=24.22.3
NEXT_VERSION=16.4.6
NGINX_VERSION=1.30.6
POSTGRES_VERSION=18.6
REDIS_VERSION=8.10.3
MAILPIT_VERSION=v1.33.1
VITE_VERSION=8.3.8
REACT_VERSION=19.3.1

# Ports (28xxx block). Published: nginx, postgres, redis, mailpit. Dev ports are internal to the node container.
NGINX_HTTP_PORT=28080
POSTGRES_PORT=28432
REDIS_PORT=28379
MAILPIT_SMTP_PORT=28025
MAILPIT_UI_PORT=28026
PORTAL_DEV_PORT=28300
ADMIN_DEV_PORT=28301

POSTGRES_DB=gdsite
POSTGRES_USER=gdsite
POSTGRES_PASSWORD=change-me

REDIS_USER=gdsite
REDIS_PASSWORD=change-me

LOCALE_DEFAULT=en
LOCALE_FALLBACK=en
LOCALE_SUPPORTED=en
