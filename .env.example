# Copy to .env (make up does this automatically) and change every "change-me".
COMPOSE_PROJECT_NAME=gdsite
COMPOSE_PROFILES=dev
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_DOMAIN=gdsite.localhost

# Pins (source of truth: docs/VERSIONS.md; checked by `make versions`)
PHP_VERSION=8.5.12
LARAVEL_VERSION=13.29.0
COMPOSER_VERSION=2.11.2
NODE_VERSION=24.22.3
NEXT_VERSION=16.4.6
NGINX_VERSION=1.30.6
MARIADB_VERSION=11.8.9
MAILPIT_VERSION=v1.33.1
VITE_VERSION=8.3.8
REACT_VERSION=19.3.1

# Ports (28xxx block). Published: nginx, mariadb, mailpit. Dev ports are internal to the node container.
NGINX_HTTP_PORT=28080
MARIADB_PORT=28306
MAILPIT_SMTP_PORT=28025
MAILPIT_UI_PORT=28026
PORTAL_DEV_PORT=28300
ADMIN_DEV_PORT=28301

MARIADB_DATABASE=gdsite
MARIADB_USER=gdsite
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me

LOCALE_DEFAULT=en
LOCALE_FALLBACK=en
LOCALE_SUPPORTED=en

# Uploads (mount point inside php + nginx containers; max size in MB)
UPLOADS_CONTAINER_PATH=/var/www/uploads
UPLOADS_MAX_MB=5

# Portal revalidation webhook (empty URL = disabled) and contact form fallback recipient
PORTAL_REVALIDATE_URL=
PORTAL_REVALIDATE_SECRET=change-me
CONTACT_NOTIFY_TO=

# Admin SPA OAuth client id (must equal OAUTH_ADMIN_CLIENT_ID in api/.env)
OAUTH_ADMIN_CLIENT_ID=e98a6a07-2975-4f52-941e-d9b6b27eb580
