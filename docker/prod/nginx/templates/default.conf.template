# Production nginx (envsubst renders this into /etc/nginx/conf.d/default.conf).
# Three public names share one certificate (SAN or wildcard) mounted at /etc/nginx/certs/{fullchain,privkey}.pem:
#   ${APP_DOMAIN}        portal (Next.js server in the portal container)
#   admin.${APP_DOMAIN}  admin SPA (static files baked into this image) + /api and /oauth/token proxied to php
#   api.${APP_DOMAIN}    API, OAuth login/authorize pages, uploads
# Port 8080 is internal only (never published): the portal's server-side API calls, without TLS.
server_tokens off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Plain http: health check and redirect to https. Nothing else is served in the clear.
server {
    listen 80 default_server;
    server_name _;
    location = /healthz { return 200 "ok\n"; }
    location / { return 301 https://$host$request_uri; }
}

# Unknown names on https: close the connection.
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    return 444;
}

# Internal API for the portal container (compose network only).
server {
    listen 8080;
    server_name _;
    client_max_body_size 1m;
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    location / {
        include fastcgi_params;
        fastcgi_pass php:9000;
        fastcgi_param SCRIPT_FILENAME /var/www/api/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_hide_header X-Powered-By;
    }
}

# Shared TLS settings for the three public vhosts.
ssl_protocols TLSv1.2 TLSv1.3;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;

# portal
server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    resolver 127.0.0.11 valid=10s;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://api.${APP_DOMAIN}; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    location / {
        set $upstream http://portal:3000;
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# admin SPA: static, same-origin with the API (no CORS)
server {
    listen 443 ssl;
    http2 on;
    server_name admin.${APP_DOMAIN};
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    root /usr/share/nginx/admin;
    client_max_body_size ${UPLOADS_MAX_MB}m;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.${APP_DOMAIN}; font-src 'self' data:; connect-src 'self' https://api.${APP_DOMAIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    location ~ ^/(api/|oauth/token$) {
        include fastcgi_params;
        fastcgi_pass php:9000;
        fastcgi_param SCRIPT_FILENAME /var/www/api/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_hide_header X-Powered-By;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'" always;
    }
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.${APP_DOMAIN}; font-src 'self' data:; connect-src 'self' https://api.${APP_DOMAIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    }
}

# api: php-fpm + static uploads
server {
    listen 443 ssl;
    http2 on;
    server_name api.${APP_DOMAIN};
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    client_max_body_size ${UPLOADS_MAX_MB}m;
    include /etc/nginx/snippets/security-headers.conf;
    # JSON plus the OAuth login page. No form-action: Chrome applies it to the redirect chain after the login POST.
    add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'" always;

    # Static only: nothing in uploads is ever executed.
    location ^~ /uploads/ {
        alias ${UPLOADS_CONTAINER_PATH}/;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        expires 7d;
    }
    location / {
        include fastcgi_params;
        fastcgi_pass php:9000;
        fastcgi_param SCRIPT_FILENAME /var/www/api/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_hide_header X-Powered-By;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'" always;
    }
}
