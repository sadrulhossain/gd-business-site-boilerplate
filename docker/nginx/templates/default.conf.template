# Rendered by the nginx image (envsubst) into /etc/nginx/conf.d/default.conf.
# Security headers: snippets/security-headers.conf plus a Content-Security-Policy per vhost (see docs/SECURITY.md).
server_tokens off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    server_name _;
    include /etc/nginx/snippets/security-headers.conf;
    location = /healthz { return 200 "ok\n"; }
    location / { return 404; }
}

# portal = APP_DOMAIN (Next dev server).
# Dev CSP: Next and Vite need 'unsafe-eval' (HMR) and inline scripts. Production builds should use nonces and drop both.
server {
    listen 80;
    server_name ${APP_DOMAIN};
    resolver 127.0.0.11 valid=10s;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://api.${APP_DOMAIN}:* https://api.${APP_DOMAIN}; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    location / {
        set $upstream http://node:${PORTAL_DEV_PORT};
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# admin.* (Vite dev server). /api and /oauth/token go to php so the SPA is same-origin with the API (no CORS).
server {
    listen 80;
    server_name admin.${APP_DOMAIN};
    root /var/www/api/public;
    client_max_body_size ${UPLOADS_MAX_MB}m;
    resolver 127.0.0.11 valid=10s;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://api.${APP_DOMAIN}:* https://api.${APP_DOMAIN}; font-src 'self' data:; connect-src 'self' http://api.${APP_DOMAIN}:* https://api.${APP_DOMAIN}; object-src 'none'; base-uri 'self'; form-action 'self' http://api.${APP_DOMAIN}:* https://api.${APP_DOMAIN}; frame-ancestors 'none'" always;
    location ~ ^/(api/|oauth/token$) {
        set $fpm php:9000;
        fastcgi_pass $fpm;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_hide_header X-Powered-By;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'" always;
    }
    location / {
        set $upstream http://node:${ADMIN_DEV_PORT};
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://api.${APP_DOMAIN}:* https://api.${APP_DOMAIN}; font-src 'self' data:; connect-src 'self' http://api.${APP_DOMAIN}:* https://api.${APP_DOMAIN}; object-src 'none'; base-uri 'self'; form-action 'self' http://api.${APP_DOMAIN}:* https://api.${APP_DOMAIN}; frame-ancestors 'none'" always;
    }
}

# api.* (php-fpm + static uploads)
server {
    listen 80;
    server_name api.${APP_DOMAIN};
    root /var/www/api/public;
    index index.php;
    client_max_body_size ${UPLOADS_MAX_MB}m;
    resolver 127.0.0.11 valid=10s;
    # Visitor IP for the API throttles: trust X-Forwarded-For only from our own network (the portal server forwards it).
    # In production set TRUSTED_PROXY_CIDR to the internal range / load balancer only; a wider range lets clients spoof their IP.
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    include /etc/nginx/snippets/security-headers.conf;
    # JSON plus the OAuth login page. No form-action: Chrome applies it to the redirect chain after the login POST.
    add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'" always;

    # Static only: ^~ beats the .php regex, so nothing in uploads is ever executed.
    location ^~ /uploads/ {
        alias ${UPLOADS_CONTAINER_PATH}/;
        include /etc/nginx/snippets/security-headers.conf;
        # Uploaded files are never documents: no scripts, no framing, nothing but being an image.
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        expires 7d;
    }
    location / {
        try_files $uri /index.php?$query_string;
    }
    location ~ \.php$ {
        set $fpm php:9000;
        fastcgi_pass $fpm;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_hide_header X-Powered-By;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'" always;
    }
}
