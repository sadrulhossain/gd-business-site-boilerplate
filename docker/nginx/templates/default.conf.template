# Rendered by the nginx image (envsubst) into /etc/nginx/conf.d/default.conf.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    server_name _;
    location = /healthz { return 200 "ok\n"; }
    location / { return 404; }
}

# portal = APP_DOMAIN (Next dev server)
server {
    listen 80;
    server_name ${APP_DOMAIN};
    resolver 127.0.0.11 valid=10s;
    location / {
        set $upstream http://node:${PORTAL_DEV_PORT};
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# admin.* (Vite dev server)
server {
    listen 80;
    server_name admin.${APP_DOMAIN};
    resolver 127.0.0.11 valid=10s;
    location / {
        set $upstream http://node:${ADMIN_DEV_PORT};
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# api.* (php-fpm)
server {
    listen 80;
    server_name api.${APP_DOMAIN};
    root /var/www/api/public;
    index index.php;
    resolver 127.0.0.11 valid=10s;
    location / {
        try_files $uri /index.php?$query_string;
    }
    location ~ \.php$ {
        set $fpm php:9000;
        fastcgi_pass $fpm;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }
}
