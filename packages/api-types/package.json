{
  "name": "@gd/api-types",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript types generated from openapi.json (Scramble export, see `make openapi`).",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "catalog:"
  }
}